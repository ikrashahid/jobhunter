# FastAPI / pipeline / scrapers (repo root or Railway)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_KEY=your_supabase_service_role_key
GROQ_API_KEY=
TAVILY_API_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Shared secret — required on every /api/* route (except /health)
# Must match frontend/.env.local API_KEY. Never commit a real value.
API_KEY=generate-a-long-random-string

# Optional: pin browser origins if anything still hits Railway directly.
# Server-side Next.js proxy does not need CORS. No *.vercel.app wildcards.
CORS_ORIGINS=http://localhost:3000

# Seconds between repeated /api/trigger/{fetch,score,draft} calls (default 120)
TRIGGER_COOLDOWN_SEC=120
